# Copy to ./mskui.toml (or ~/.config/mskui/config.toml) and edit.
# One [[env]] block per MSK cluster.
#
# auth picks the wire protocol — match it to your bootstrap port:
#   "plaintext" → port 9092 (no TLS, no auth; typical VPC-internal cluster)
#   "tls"       → port 9094 (TLS, no auth)
#   "iam"       → port 9098 (SASL_SSL + MSK IAM, uses your ~/.aws creds)  [default]
#
# NOTE: MSK brokers are usually private VPC IPs. You must run mskui somewhere
# that can route to them (on the VPC's VPN, or on a bastion inside the VPC).

[[env]]
name = "stag"
bootstrap = "b-1.mycluster.xxxxx.c2.kafka.eu-central-1.amazonaws.com:9092,b-2.mycluster.xxxxx.c2.kafka.eu-central-1.amazonaws.com:9092"
region = "eu-central-1"
auth = "plaintext"
prod = false

[[env]]
name = "prod"
bootstrap = "b-1.prod.xxxxx.c2.kafka.eu-central-1.amazonaws.com:9098"
region = "eu-central-1"
auth = "iam"
prod = true   # destructive ops require typing the topic name to confirm
